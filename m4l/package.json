{
  "name": "@stencil/m4l",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Stencil M4L target — pnpm workspace root for engine and host packages.",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "bundle:host": "esbuild stencil.entry.mjs --bundle --platform=node --format=esm --external:max-api --outfile=stencil.mjs",
    "bake": "pnpm bundle:host && node scripts/maxpat-to-amxd.mjs",
    "bake:check": "node scripts/maxpat-to-amxd.mjs --check"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3",
    "@types/node": "^25.9.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
